{
  "$schema": "../../schemas/chain.schema.json",
  "chain_name": "noble",
  "chain_id": "noble-1",
  "pretty_name": "Noble",
  "chain_type": "cosmos",
  "status": "live",
  "network_type": "mainnet",
  "website": "https://noble.xyz",
  "bech32_prefix": "noble",
  "daemon_name": "nobled",
  "node_home": "$HOME/.noble",
  "slip44": 118,
  "key_algos": [
    "secp256k1"
  ],
  "fees": {
    "fee_tokens": [
      {
        "denom": "uusdc",
        "fixed_min_gas_price": 0,
        "low_gas_price": 0.1,
        "average_gas_price": 0.1,
        "high_gas_price": 0.2
      }
    ]
  },
  "staking": {
    "staking_tokens": [
      {
        "denom": "ustake"
      }
    ]
  },
  "codebase": {
    "git_repo": "https://github.com/noble-assets/noble",
    "cosmos_sdk_version": "0.50",
    "consensus": {
      "type": "cometbft",
      "version": "0.38"
    },
    "ibc_enabled": true
  },
  "apis": {
    "rpc": [
      {
        "address": "https://noble-rpc.polkachu.com",
        "provider": "Polkachu"
      }
    ],
    "rest": [
      {
        "address": "https://noble-api.polkachu.com",
        "provider": "Polkachu"
      }
    ]
  },
  "explorers": [
    {
      "kind": "mintscan",
      "url": "https://www.mintscan.io/noble",
      "tx_page": "https://www.mintscan.io/noble/tx/${txHash}",
      "account_page": "https://www.mintscan.io/noble/address/${accountAddress}"
    }
  ],
  "features": [
    "stargate",
    "ibc-transfer",
    "ibc-go"
  ],
  "logo_URIs": {
    "png": "https://raw.githubusercontent.com/Safrochain-Org/token-registry/main/mainnet/noble/images/noble.png"
  }
}
